# =====================================================================
# DIGITAL NETWORK PLATFORM v1.0 - DOCKERFILE
# =====================================================================

# Шаг 1: Используем официальный легковесный образ Python
FROM python:3.10-slim

# Шаг 2: Устанавливаем системные зависимости для сборки (необходимы для компиляции некоторых модулей SciPy)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Шаг 3: Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Шаг 4: Копируем файл зависимостей и устанавливаем библиотеки
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Шаг 5: Копируем весь исходный код платформы в контейнер
COPY . .

# Шаг 6: Открываем порт 8000 для сетевых запросов течеискателей АТЭК
EXPOSE 8000

# Шаг 7: Запускаем веб-сервер Uvicorn в многопоточном продакшен-режиме
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
